---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Each recommendation is shown in full, with the excerpt used elsewhere on the site highlighted
// in place, so a reader can see exactly where every quote comes from.
const recommendations = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data: t }) => {
    const fragments = t.excerpt.split('…').map(s => s.trim()).filter(Boolean);
    const parts: { text: string; quoted: boolean }[] = [];
    let rest = t.quote;
    for (const f of fragments) {
      const i = rest.indexOf(f);
      parts.push({ text: rest.slice(0, i), quoted: false }, { text: f, quoted: true });
      rest = rest.slice(i + f.length);
    }
    parts.push({ text: rest, quoted: false });
    return { ...t, parts };
  });
---

<Layout
  title="Recommendations | COM<tech> Consulting"
  description="Recommendations for Anders Hybertz from clients, colleagues, and people he has led at Novo Nordisk, RSA / Codan, SDC, and others, in full."
  closeHeading="Let's discuss your architecture."
  closeBody="Send a short description of the system and the decision in front of you."
>
  <div slot="opening" class="intro">
    <div class="container">
      <h1 class="page-title">Recommendations</h1>
      <p class="lead">From clients, colleagues, and people I have led, newest work first and in full. The highlighted lines are the ones quoted elsewhere on this site.</p>
    </div>
  </div>

  <section class="section" aria-label="Recommendations">
    <div class="container">
      <ol class="recs">
        {recommendations.map(t => (
          <li>
            <div class="who">
              <h2>{t.name}</h2>
              <p>{t.title}</p>
              <p class="ctx">{t.context}</p>
            </div>
            <blockquote class="text">&ldquo;{t.parts.map(p => (p.quoted ? <mark>{p.text}</mark> : p.text))}&rdquo;</blockquote>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  .recs { list-style: none; border-top: 1px solid var(--rule); }
  .recs li {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: 16px 72px;
    padding: 44px 0 48px;
    border-bottom: 1px solid var(--rule);
  }
  .recs li:last-child { border-bottom: 0; }
  .who h2 { font-size: 21px; letter-spacing: -0.012em; line-height: 1.25; }
  .who p { margin-top: 6px; font-size: 15px; line-height: 1.5; }
  .who .ctx { padding-top: 12px; margin-top: 14px; border-top: 1px solid var(--rule); color: var(--ink-3); }
  .text {
    max-width: 62ch;
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.65;
    color: var(--ink-2);
    white-space: pre-line;
  }
  .text mark {
    color: var(--ink);
    font-weight: 600;
    background: linear-gradient(transparent 60%, var(--signal-tint) 60%);
  }
  @media (max-width: 900px) {
    .recs li { grid-template-columns: 1fr; padding: 32px 0 36px; }
  }
</style>
