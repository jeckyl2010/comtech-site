---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const featured  = (await getCollection('testimonialsF')).sort((a, b) => a.data.order - b.data.order);
const standard  = (await getCollection('testimonialsS')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Testimonials | COM<tech>"
  description="Selected recommendations for Anders Hybertz and COM<tech>. From engineering leaders and clients at Novo Nordisk, KPMG, N3O, and others — on architecture, technical leadership, and delivery under pressure."
>
  <section class="section">
    <div class="container testimonials-page">
      <div class="testimonials-header">
        <p class="section-label">Client testimonials</p>
        <h1 class="page-h1">What clients say when the work has to hold up</h1>
        <p class="page-lead testimonials-lead">
          Selected recommendations from clients, colleagues, and direct reports. Full text expandable below each excerpt.
        </p>
      </div>

      <div class="featured-grid">
        {featured.map((t) => (
          <article class="featured-card card">
            <p class="t-category label-caps-muted">{t.data.category}</p>
            <blockquote class="featured-excerpt">&ldquo;{t.data.excerpt}&rdquo;</blockquote>
            <div class="t-author">
              <strong>{t.data.name}</strong>
              <span>{t.data.title}</span>
            </div>
            <details class="quote-details">
              <summary>Read full recommendation</summary>
              <blockquote class="full-quote">&ldquo;{t.data.quote}&rdquo;</blockquote>
            </details>
          </article>
        ))}
      </div>

      <div class="testimonial-list">
        {standard.map((t) => (
          <article class="testimonial-item">
            <div>
              <p class="t-category label-caps-muted">{t.data.category}</p>
              <div class="t-author">
                <strong>{t.data.name}</strong>
                <span>{t.data.title}</span>
              </div>
            </div>
            <div class="testimonial-body">
              <p class="testimonial-excerpt">{t.data.excerpt}</p>
              <details class="quote-details">
                <summary>Read full recommendation</summary>
                <blockquote class="full-quote">&ldquo;{t.data.quote}&rdquo;</blockquote>
              </details>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <p class="section-label">When to reach out</p>
      <h2>Need a calm senior perspective on a difficult delivery?</h2>
      <p>
        If an important technical decision is approaching, a delivery has become harder to steer, or
        the architecture needs to hold up outside the meeting room, write.
      </p>
      <a href="/contact/" class="btn btn-primary">Contact Anders</a>
    </div>
  </section>
</Layout>

<style>
  .testimonials-page {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .testimonials-header {
    display: flex;
    flex-direction: column;
  }

  .testimonials-lead {
    max-width: 62ch;
    margin-top: -0.5rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .featured-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-excerpt {
    margin: 0;
    padding: 0;
    color: var(--text);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .testimonial-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .testimonial-item {
    display: grid;
    grid-template-columns: minmax(180px, 0.9fr) minmax(0, 2fr);
    gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .testimonial-body {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .testimonial-excerpt {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 500;
  }

  .t-category {
    color: var(--text-3);
    margin-bottom: 0.875rem;
  }

  .t-author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.875rem;
    color: var(--text-3);
  }

  .t-author strong {
    color: var(--text-2);
    font-weight: 600;
  }

  .quote-details {
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.875rem;
  }

  .quote-details summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    width: fit-content;
  }

  .quote-details summary::-webkit-details-marker {
    display: none;
  }

  .quote-details summary::after {
    content: ' +';
  }

  .quote-details[open] summary::after {
    content: ' −';
  }

  .full-quote {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-2);
    border-left: 3px solid var(--accent);
    padding: 0 0 0 1rem;
  }

  @media (max-width: 980px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .testimonial-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 680px) {
    .testimonials-page {
      gap: 2.25rem;
    }

    .featured-card {
      padding: 1.5rem;
    }

    .featured-excerpt {
      font-size: 1.0625rem;
    }
  }
</style>
