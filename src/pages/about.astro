---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry, z } from 'astro:content';
import CtaStrip from '../components/CtaStrip.astro';
import rawAbout from '../data/about.json';

const strengths = (await getCollection('strengths')).sort((a, b) => a.data.order - b.data.order);
const awards    = (await getCollection('awards')).sort((a, b) => a.data.order - b.data.order);
const clients   = (await getCollection('clients')).sort((a, b) => a.data.order - b.data.order);
const morten    = (await getEntry('testimonials', 'morten-foltmar'))!.data;

const { domains, technologies } = z.object({
  domains:      z.array(z.string()),
  technologies: z.array(z.string()),
}).parse(rawAbout);
---

<Layout
  title="About | COM<tech>"
  description="About Anders Hybertz and COM<tech>. Three decades of software architecture, technical leadership, and complex delivery across pharmaceutical manufacturing, finance, energy, and the public sector. One senior point of contact from the first conversation."
>

  <section class="section">
    <div class="container">
      <div class="about-intro-grid">
        <div>
          <h1 class="page-h1">Anders Hybertz</h1>
          <p class="about-lead">
            COM&lt;tech&gt; is a one-person consultancy by design. Clients work directly with Anders from the first conversation and throughout the engagement.
          </p>
          <p class="about-body">
            Since 2000, the work has centred on software architecture, technical leadership, and difficult deliveries across regulated industries and complex organisations. The common denominator is not a particular technology. It is situations where the architecture matters, the systems have to hold up in practice, and the organisation needs clear judgement rather than noise.
          </p>
          <p class="about-body about-body-spaced">
            The working style is pragmatic, calm, and long-term minded. Good solutions balance technical quality, business reality, and a team's ability to evolve them over time. The preference is to be present from the first architectural decision through to production — and to see value delivered, not just handed over.
          </p>
          <p class="about-court">
            In 2022, Danmarks Domstole appointed Anders to a five-member expert panel at Sø- og Handelsretten
            as an independent software expert in a commercial software dispute.{' '}
            <a href="#recognition">See recognition</a>
          </p>
        </div>
        <div>
          <figure class="about-pull-quote blockquote-card">
            <blockquote>&ldquo;{morten.excerpt}&rdquo;</blockquote>
            <figcaption class="testimonial-author"><strong>{morten.name}</strong>, {morten.title}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-h2">Professional craftsmanship over noise</h2>
      <p class="section-sub section-sub-wide">
        The aim is to create clarity, reduce unnecessary complexity, and make sound decisions that the organisation can live with afterwards. Less noise. More substance. Architecture should help the work move forward, not become a separate performance around it.
      </p>
      <div class="strengths-grid">
        {strengths.map(s => (
          <div class="strength-item">
            <h3>{s.data.title}</h3>
            <p>{s.data.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-h2 section-h2-tight">What clients typically bring me in for</h2>
      <p class="section-sub">
        Architecture work under delivery pressure. Modernisation without unnecessary rewrites. Technical leadership where teams need direction, calm, and practical judgement.
      </p>
      <div class="focus-grid">

        <div class="card focus-card">
          <h3>Architecture and delivery recovery</h3>
          <p>When a programme or project has become technically unclear, too coupled, or difficult to steer, the first task is usually to make the shape of the problem visible and help the team regain control.</p>
        </div>

        <div class="card focus-card">
          <h3>Regulated and high-consequence systems</h3>
          <p>Work where traceability, auditability, documentation, and reliability are not administrative extras but part of what makes the solution acceptable.</p>
        </div>

        <div class="card focus-card">
          <h3>Cloud, platform, and AI decisions</h3>
          <p>Especially where there is a need to separate useful technology choices from fashionable ones, and where operations and adoption matter as much as the architecture diagram.</p>
        </div>

        <div class="card focus-card">
          <h3>Senior sparring for teams and leaders</h3>
          <p>Architecture reviews, technical direction, mentoring, and independent judgement in situations where internal teams need an experienced outside perspective without a lot of consulting noise.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-h2 section-h2-snug">Organisations I have worked with</h2>
      <p class="section-sub">Most recent first, with the period and the work.</p>
      <ol class="client-ledger">
        {clients.map(c => (
          <li class="client-row">
            <span class="client-years">{c.data.years}</span>
            <div class="client-who">
              <h3>{c.data.name}</h3>
              <p class="client-sector">{c.data.sector}</p>
            </div>
            <p class="client-work">
              {c.data.work}
              {c.data.link && <a class="client-link" href={c.data.link.href} rel="noopener">{c.data.link.label}</a>}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="domains-tech-grid">
        <div>
          <h2 class="section-h2 section-h2-snug">Where I have worked</h2>
          <p class="section-sub section-sub-snug">
            Different sectors, but usually with real operational, financial, or regulatory consequences.
          </p>
          <div class="domain-list">
            {domains.map(d => <span class="tag tag-md">{d}</span>)}
          </div>
        </div>
        <div>
          <h2 class="section-h2 section-h2-snug">Core stack</h2>
          <p class="section-sub section-sub-snug">
            Strongest around the Microsoft ecosystem, but guided by architecture and context rather than attachment to a stack.
          </p>
          <div class="domain-list">
            {technologies.map(t => <span class="tag tag-md">{t}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="recognition">
    <div class="container">
      <h2 class="section-h2 section-h2-snug">Appointments, awards, and nominations</h2>
      <p class="section-sub section-sub-narrow">
        Recognition from clients, peers, the freelance network, and courts. Useful as a trust signal, but always secondary to whether the work itself stands up.
      </p>
      <div class="awards-list">
        {awards.map(a => (
          <div class:list={['award-item', { 'award-item--featured': a.data.featured }]}>
            <div class="award-year label-caps">{a.data.year}</div>
            <div>
              <h3>{a.data.title}</h3>
              <p>{a.data.issuer}</p>
              {a.data.detail && <p class="award-detail">{a.data.detail}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    heading="Need a calm senior perspective on a difficult situation?"
    body="If a system has become harder to steer, a delivery needs firmer technical footing, or an important decision should be worked through properly, write."
  >
    <div class="btn-row">
      <a href="/testimonials/" class="btn btn-ghost">Read recommendations</a>
      <a href="/contact/" class="btn btn-primary">Contact Anders</a>
    </div>
  </CtaStrip>

</Layout>

<style>
  .about-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .about-lead {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.875rem;
    line-height: 1.7;
  }
  .about-body {
    font-size: 1rem;
    color: var(--text-2);
    line-height: 1.75;
  }
  .about-body-spaced { margin-top: 1rem; }
  .section-h2 { margin-bottom: 1rem; }
  .section-h2-tight { margin-bottom: 0.5rem; }
  .section-h2-snug { margin-bottom: 0.75rem; }
  .section-sub { max-width: 58ch; margin-bottom: 2rem; color: var(--text-2); }
  .section-sub-wide { max-width: 60ch; margin-bottom: 2.5rem; }
  .section-sub-snug { max-width: none; margin-bottom: 1.25rem; }
  .section-sub-narrow { max-width: 52ch; }
  .award-detail { margin-top: 0.375rem; max-width: var(--measure); }
  .about-court {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--text);
  }
  .about-court a {
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
  .about-court a:hover { color: var(--accent-hover); }
  #recognition { scroll-margin-top: var(--nav-h); }
  .about-pull-quote {
    margin-top: 3rem;
  }
  .domains-tech-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 768px) {
    .about-intro-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-pull-quote { margin-top: 0; }
    .domains-tech-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  .client-ledger {
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .client-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 15rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--border);
  }
  .client-years {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .client-who h3 { font-size: 0.9375rem; }
  .client-sector { font-size: 0.8125rem; color: var(--text-3); }
  .client-work { max-width: var(--measure); font-size: 0.9375rem; line-height: 1.65; }
  .client-link {
    display: block;
    width: fit-content;
    margin-top: 0.25rem;
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--accent-border);
    text-underline-offset: 0.2em;
  }
  .client-link:hover { color: var(--accent-hover); text-decoration-color: currentColor; }
  @media (max-width: 768px) {
    .client-row { grid-template-columns: 1fr; gap: 0.25rem; }
    .client-work { margin-top: 0.375rem; }
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .focus-card { padding: 1.5rem; }
  .focus-card h3 { font-size: 0.9375rem; margin-bottom: 0.5rem; }
  .focus-card p { font-size: 0.875rem; line-height: 1.65; }
  @media (max-width: 640px) {
    .focus-grid { grid-template-columns: 1fr; }
  }
</style>
