---
import Layout from '../layouts/Layout.astro';

const domains = [
  'Pharmaceutical manufacturing',
  'Financial services and insurance',
  'Manufacturing and industrial',
  'Energy and utilities',
  'Public sector',
  'Telecom and mobile',
  'Healthcare and life sciences',
  'Banking',
];

const strengths = [
  {
    title: 'Architecture with a long view',
    body: 'Decisions should still make sense when the project pressure is gone. Maintainability, traceability, and operational reality are part of the job from the beginning.',
  },
  {
    title: 'Pragmatic and clear-headed',
    body: 'There are no best practices — only good practices, and the judgment to know which ones fit here. It starts with listening. Understanding the actual problem before proposing a solution is not a courtesy. It is the work.',
  },
  {
    title: 'Hands-on when needed',
    body: 'Architecture, delivery, reviews, mentoring, and implementation support. The work follows the problem instead of protecting a role description.',
  },
  {
    title: 'Calm under delivery pressure',
    body: 'Much of the work has been in programmes with real deadlines, competing stakeholders, and systems that could not simply fail and be retried later.',
  },
  {
    title: 'Knowledge that stays behind',
    body: 'An engagement should leave the organisation with better understanding, better practices, and a team that can continue without artificial dependency.',
  },
  {
    title: 'Less, but better',
    body: 'Complexity is easy to add and expensive to carry. Good architecture often comes from reducing what is unnecessary and making the rest clearer.',
  },
];

const technologies = [
  '.NET / C#', 'Python', 'Microsoft Azure', 'Kubernetes', 'Docker', 'Dapr',
  'Azure DevOps', 'Terraform', 'Bicep', 'Event-driven architecture',
  'RESTful APIs', 'Azure ML', 'OpenShift', 'CI/CD pipelines',
];

const awards = [
  {
    year: '2022',
    title: 'Court-Appointed Independent Software Expert',
    issuer: 'Danmarks Domstole · Sø- og Handelsretten',
    detail: 'Appointed to a five-member expert panel to provide independent technical assessment in a commercial software dispute. Held primary responsibility for architecture, application design, performance, and adherence to established engineering practices. Contributed to resolving the matter before the first court date.',
    featured: true,
  },
  {
    year: '2021',
    title: 'PSQIT Innovation Prize 2020',
    issuer: 'Novo Nordisk',
    detail: 'Team prize for a solution that optimised batch changeover procedures on production lines.',
  },
  {
    year: '2020',
    title: 'Best Individual Performance of the Year',
    issuer: '7N, associated with Novo Nordisk',
    detail: '',
  },
  {
    year: '2016',
    title: 'Best Individual Performance of the Year',
    issuer: '7N, associated with RSA / Codan',
    detail: '',
  },
  {
    year: '2016',
    title: 'Nominee, Best Team Performance of the Year',
    issuer: '7N, associated with RSA / Codan',
    detail: '',
  },
];
---

<Layout
  title="About | COM<tech>"
  description="About Anders Hybertz and COM<tech>. Senior software architect and technical lead based in Copenhagen, Denmark."
>

  <section class="section">
    <div class="container">
      <div class="about-intro-grid">
        <div class="about-intro-left">
          <p class="section-label">About</p>
          <h1 class="page-h1">Anders Hybertz</h1>
          <p class="about-lead">
            COM&lt;tech&gt; is a one-person consultancy by design. Clients work directly with Anders from the first conversation and throughout the engagement.
          </p>
          <p class="about-body">
            Since 2000, the work has centred on software architecture, technical leadership, and difficult deliveries across pharmaceutical manufacturing, finance, insurance, energy, telecom, and the public sector. The common denominator is not a particular technology. It is situations where the architecture matters, the systems have to hold up in practice, and the organisation needs clear judgement rather than noise.
          </p>
          <p class="about-body" style="margin-top: 1rem;">
            The working style is pragmatic, calm, and long-term minded. Ambition matters, but so does fit. Good solutions are usually the ones that balance technical quality, business reality, and the ability of a team to evolve them over time.
          </p>
        </div>
        <div class="about-intro-right">
          <blockquote class="about-pull-quote">
            &ldquo;Anders not only has a sharp mind but is also able to share his ideas and visions in a manner that makes the team-members join in. He also possesses the ability to lift the competences of his team-members.&rdquo;
            <div class="testimonial-author">
              <strong>Morten Edward Foltmar</strong>, Freelance Software Developer, AP Pension
            </div>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="section-label">How I work</p>
      <h2 style="margin-bottom: 1rem;">Professional craftsmanship over noise</h2>
      <p style="max-width: 60ch; margin-bottom: 2.5rem;">
        The aim is to create clarity, reduce unnecessary complexity, and make sound decisions that the organisation can live with afterwards. Less noise. More substance. Architecture should help the work move forward, not become a separate performance around it.
      </p>
      <div class="strengths-grid">
        {strengths.map(s => (
          <div class="strength-item">
            <h4>{s.title}</h4>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-label">Selected focus areas</p>
      <h2 style="margin-bottom: 0.5rem;">What clients typically bring me in for</h2>
      <p style="max-width: 58ch; margin-bottom: 2rem; color: var(--text-2);">
        Architecture work under delivery pressure. Modernisation without unnecessary rewrites. Technical leadership where teams need direction, calm, and practical judgement.
      </p>
      <div class="repo-grid repo-grid-single-source">

        <div class="repo-card repo-card-static">
          <div class="repo-card-header">
            <span class="repo-name">Architecture and delivery recovery</span>
          </div>
          <p class="repo-desc">When a programme or project has become technically unclear, too coupled, or difficult to steer, the first task is usually to make the shape of the problem visible and help the team regain control.</p>
        </div>

        <div class="repo-card repo-card-static">
          <div class="repo-card-header">
            <span class="repo-name">Regulated and high-consequence systems</span>
          </div>
          <p class="repo-desc">Work where traceability, auditability, documentation, and reliability are not administrative extras but part of what makes the solution acceptable.</p>
        </div>

        <div class="repo-card repo-card-static">
          <div class="repo-card-header">
            <span class="repo-name">Cloud, platform, and AI decisions</span>
          </div>
          <p class="repo-desc">Especially where there is a need to separate useful technology choices from fashionable ones, and where operations and adoption matter as much as the architecture diagram.</p>
        </div>

        <div class="repo-card repo-card-static">
          <div class="repo-card-header">
            <span class="repo-name">Senior sparring for teams and leaders</span>
          </div>
          <p class="repo-desc">Architecture reviews, technical direction, mentoring, and independent judgement in situations where internal teams need an experienced outside perspective without a lot of consulting noise.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="domains-tech-grid">
        <div>
          <p class="section-label">Industries</p>
          <h2 style="margin-bottom: 0.75rem;">Where I have worked</h2>
          <p style="margin-bottom: 1.25rem; color: var(--text-2);">
            Different sectors, but usually with real operational, financial, or regulatory consequences.
          </p>
          <div class="domain-list">
            {domains.map(d => <span class="tag" style="font-size: 0.8125rem; padding: 0.375rem 0.875rem;">{d}</span>)}
          </div>
        </div>
        <div>
          <p class="section-label">Technologies</p>
          <h2 style="margin-bottom: 0.75rem;">Core stack</h2>
          <p style="margin-bottom: 1.25rem; color: var(--text-2);">
            Strongest around the Microsoft ecosystem, but guided by architecture and context rather than attachment to a stack.
          </p>
          <div class="domain-list">
            {technologies.map(t => <span class="tag" style="font-size: 0.8125rem; padding: 0.375rem 0.875rem;">{t}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-label">Recognition</p>
      <h2 style="margin-bottom: 0.75rem;">Appointments, awards, and nominations</h2>
      <p style="max-width: 52ch; margin-bottom: 2rem;">
        Recognition from clients, peers, the freelance network, and courts. Useful as a trust signal, but always secondary to whether the work itself stands up.
      </p>
      <div class="awards-list">
        {awards.map(a => (
          <div class={`award-item${a.featured ? ' award-item--featured' : ''}`}>
            <div class="award-year">{a.year}</div>
            <div class="award-content">
              <h4>{a.title}</h4>
              <p>{a.issuer}</p>
              {a.detail && <p style="margin-top: 0.375rem;">{a.detail}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <p class="section-label">When to reach out</p>
      <h2>Need a calm senior perspective on a difficult situation?</h2>
      <p>If a system has become harder to steer, a delivery needs firmer technical footing, or an important decision should be worked through properly, feel free to reach out directly.</p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/testimonials/" class="btn btn-ghost">Read testimonials</a>
        <a href="/contact/" class="btn btn-primary">Contact Anders</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .about-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .about-lead {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.875rem;
    line-height: 1.7;
  }
  .about-body {
    font-size: 1rem;
    color: var(--text-2);
    line-height: 1.75;
  }
  .about-pull-quote {
    margin-top: 3rem;
  }
  .domains-tech-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 768px) {
    .about-intro-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-pull-quote { margin-top: 0; }
    .domains-tech-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  .repo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .repo-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .repo-card:hover {
    box-shadow: var(--shadow);
    border-color: rgba(83, 82, 204, 0.3);
  }
  .repo-card-static:hover {
    box-shadow: var(--shadow-sm);
    border-color: var(--border);
  }
  .repo-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .repo-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    flex: 1;
  }
  .repo-desc {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.65;
  }
  @media (max-width: 640px) {
    .repo-grid { grid-template-columns: 1fr; }
  }
</style>
