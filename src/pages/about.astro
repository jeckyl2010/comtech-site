---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection, getEntry, z } from 'astro:content';
import rawAbout from '../data/about.json';

const clients = (await getCollection('clients')).sort((a, b) => a.data.order - b.data.order);
const recent  = clients.slice(0, 4);
const earlier = clients.slice(4);
const awards  = (await getCollection('awards')).sort((a, b) => a.data.order - b.data.order);
const isabela = (await getEntry('testimonials', 'isabela-bolotti'))!.data;

const { domains, technologies } = z.object({
  domains:      z.array(z.string()),
  technologies: z.array(z.string()),
}).parse(rawAbout);
---

<Layout
  title="About | COM<tech> Consulting"
  description="Anders Hybertz: senior software architect and technical lead in Copenhagen since 2000. Recent work for ROCKWOOL Group, Klimadatastyrelsen, and Novo Nordisk, and three decades across finance, insurance, telecom, and energy."
  closeHeading="Let's discuss your architecture."
  closeBody="Send a short description of the system and the decision in front of you."
>
  <div slot="opening" class="intro">
    <div class="container">
      <div>
        <h1 class="page-title">Anders Hybertz</h1>
        <p class="role">Senior software architect and technical lead · Copenhagen</p>
      </div>
      <p class="lead">COM&lt;tech&gt; is a one-person consultancy by design. You work directly with me, from the first conversation and throughout the engagement.</p>
    </div>
  </div>

  <section class="section" aria-labelledby="h-story">
    <div class="container">
      <div class="split">
        <div>
          <h2 id="h-story" class="h2">Three decades of software that had to work</h2>
          <Timeline />
        </div>
        <div>
          <p class="body">Since 2000, my work has centred on software architecture, technical leadership, and difficult deliveries across regulated industries and complex organisations. The common denominator is not a particular technology. It is situations where the architecture matters, the systems have to hold up in practice, and the organisation needs clear judgement rather than noise.</p>
          <p class="body">I work pragmatically, calmly, and with the long term in mind. I prefer to be there from the first architectural decision through to production, and to see value delivered, not just handed over.</p>
          <figure class="aside-quote">
            <blockquote>&ldquo;{isabela.excerpt}&rdquo;</blockquote>
            <figcaption><strong>{isabela.name}</strong>{isabela.title}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="h-recent">
    <div class="container">
      <div class="section-head">
        <h2 id="h-recent" class="h2">Recent work</h2>
      </div>
      <ul class="work">
        {recent.map(c => (
          <li>
            <span class="when">{c.data.years}</span>
            <div>
              <h3>{c.data.name}</h3>
              <p class="sector">{c.data.sector}</p>
              <p>{c.data.work}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-earlier">
    <div class="container">
      <div class="cols">
        <div>
          <h2 id="h-earlier" class="h2-sm">Earlier work</h2>
          <ul class="earlier">
            {earlier.map(c => (
              <li>
                <span class="y">{c.data.years}</span>
                <span>
                  <strong>{c.data.name}</strong> · {c.data.work}
                  {c.data.link && <> <a href={c.data.link.href} rel="noopener">{c.data.link.label}</a></>}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="h2-sm">Recognition</h2>
          <ul class="facts">
            {awards.map(a => (
              <li><span class="y">{a.data.year}</span><span><strong>{a.data.title}</strong> · {a.data.issuer}{a.data.detail && <span class="detail">{a.data.detail}</span>}</span></li>
            ))}
          </ul>
          <h2 class="h2-sm stack-h">Industries</h2>
          <p class="list">{domains.join(' · ')}</p>
          <h2 class="h2-sm stack-h">Technologies</h2>
          <p class="list">{technologies.join(' · ')}</p>
          <p class="note">Strongest around the Microsoft ecosystem, but guided by the problem rather than attachment to a stack.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .role { margin-top: 14px; font-size: 18px; }
  .aside-quote { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--rule); }
  .aside-quote blockquote { font-size: 22px; line-height: 1.45; font-weight: 500; letter-spacing: -0.012em; }
  .aside-quote figcaption { margin-top: 14px; font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  .aside-quote strong { display: block; }

  .work { list-style: none; display: grid; gap: 16px; }
  .work li {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 8px 40px;
    padding: 26px 28px;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper);
  }
  .when { padding-top: 4px; font-size: 15px; font-weight: 600; color: var(--signal); }
  .work h3 { font-size: 22px; letter-spacing: -0.014em; line-height: 1.25; }
  .sector { margin: 2px 0 10px; font-size: 15px; color: var(--ink-3); }
  .work p:not(.sector) { font-size: 16px; line-height: 1.65; max-width: 72ch; }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 80px; }
  .earlier, .facts { list-style: none; margin-top: 20px; }
  .earlier li, .facts li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .y { font-weight: 600; color: var(--ink-3); }
  .detail { display: block; margin-top: 4px; color: var(--ink-3); }
  .stack-h { margin-top: 44px; }
  .list { margin-top: 14px; font-size: 16px; line-height: 1.7; color: var(--ink); }
  .note { margin-top: 10px; font-size: 15px; }

  @media (max-width: 900px) {
    .work li, .cols { grid-template-columns: 1fr; }
    .cols { gap: 48px; }
  }
</style>
