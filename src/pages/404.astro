---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | COM<tech> Consulting"
  description="This page does not exist on comtechconsulting.dk."
  noindex
>
  <div slot="opening" class="intro">
    <div class="container">
      <div>
        <h1 class="page-title">This page does not exist</h1>
        <p class="lead lost-lead">The link may be out of date, or the address may have a typo. Everything on the site is reachable from here, and email always works.</p>
      </div>
      <nav aria-label="Pages on this site">
        <ul class="pages">
          <li><a class="btn btn-ghost" href="/">Home</a></li>
          <li><a class="btn btn-ghost" href="/services/">How I work</a></li>
          <li><a class="btn btn-ghost" href="/about/">About</a></li>
          <li><a class="btn btn-ghost" href="/testimonials/">Recommendations</a></li>
          <li><a class="btn btn-ghost" href="/contact/">Contact</a></li>
          <li><a class="btn btn-primary" href="mailto:anders@comtechconsulting.dk">anders@comtechconsulting.dk</a></li>
        </ul>
      </nav>
    </div>
  </div>
</Layout>

<style>
  /* The page is all night: no empty day band between the intro and the footer. */
  :global(html body) { background: var(--night); }
  :global(body > div.night) { min-height: calc(100vh - 90px); }
  .lost-lead { margin-top: 20px; }
  .pages { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
</style>
