---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CtaStrip from '../components/CtaStrip.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Services | COM<tech>"
  description="Software architecture, cloud and AI solutions, technical leadership, and independent software auditing — practical senior consulting for organisations where the architecture matters and the delivery has to hold up."
>

  <section class="section"><div class="container">
    <p class="section-label">Services</p>
    <h1 class="page-h1">Practical support for difficult technical work</h1>
    <p class="page-lead">
      The work typically sits somewhere between architecture, delivery, and technical leadership.
      Sometimes as a lead architect. Sometimes as an experienced outside perspective. Sometimes as
      hands-on support when the situation calls for it.
    </p>

    <div class="svc-grid">
      {services.map((s) => (
        <div class:list={['svc-card', 'card', { 'svc-featured': s.data.featured }]}>
          <div class="svc-header">
            {/* set:html is safe here — icon SVGs are hardcoded static strings, not user input */}
            <div class="svc-icon" set:html={s.data.icon} />
            <h3 class="svc-title">{s.data.name}</h3>
          </div>
          <p class="svc-desc">{s.data.description}</p>
          <div class="svc-tags">
            {s.data.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div></section>

  <section class="section section-alt svc-principles-section">
    <div class="container">
      <p class="section-label">Typical situations</p>
      <div class="card-grid">
        <div class="card">
          <h3>The system has become too hard to reason about</h3>
          <p>Responsibilities are blurred, integrations have grown fragile, and every change feels more expensive than it should.</p>
        </div>
        <div class="card">
          <h3>An important technical decision needs firmer footing</h3>
          <p>For example around modernisation, cloud direction, architecture boundaries, or whether a proposed path is actually worth the cost.</p>
        </div>
        <div class="card">
          <h3>The team needs senior technical direction</h3>
          <p>Not more noise, but clearer judgement, better structure, and help carrying the work through delivery in a sustainable way.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaStrip
    label="When to reach out"
    heading="Not sure which kind of help fits yet?"
    body="The useful first conversation is usually about the problem itself, what is at stake, and where clearer technical judgement would help most."
  >
    <a href="/contact/" class="btn btn-primary">Contact Anders</a>
  </CtaStrip>

</Layout>

<style>
  .svc-principles-section { padding-top: 4rem; padding-bottom: 4rem; }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .svc-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .svc-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-self: stretch;
  }
  .svc-featured {
    grid-column: 1 / -1;
    background: var(--featured-bg);
    border-color: var(--accent-border);
  }
  .svc-featured .svc-title { font-size: 1.25rem; }
  .svc-icon {
    width: fit-content;
    padding: 0.5rem;
    background: var(--accent-dim);
    border-radius: var(--radius);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .svc-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .svc-desc {
    font-size: 0.9375rem;
    color: var(--text-2);
    line-height: 1.7;
    flex: 1;
  }
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }
  @media (max-width: 680px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
