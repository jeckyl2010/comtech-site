---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>`,
    name: 'Software architecture & design',
    description:
      'Architecture for both greenfield and legacy systems. Especially useful when the technical direction has become unclear, the system boundaries are weak, or important decisions need a calmer and more structured basis.',
    tags: ['Architecture reviews', 'System boundaries', 'Event-driven design', 'API design', 'Regulated systems', 'Technical roadmap'],
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>`,
    name: 'Cloud and AI solutions',
    description:
      'Cloud-native and AI-based solutions where they serve a real purpose. This includes platform work, containerised workloads, computer vision, and architecture that still has to function under operational and compliance constraints.',
    tags: ['Microsoft Azure', 'Kubernetes / Docker', 'Computer vision', 'AI/ML integration', 'Dapr', 'CI/CD and IaC'],
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    name: 'Technical leadership and mentoring',
    description:
      'Support for teams that need senior technical direction without unnecessary layers. Architecture reviews, sparring, mentoring, and practical help through the difficult parts of delivery.',
    tags: ['Tech lead support', 'Architecture reviews', 'Mentoring', 'Delivery governance', 'Engineering practices'],
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
    name: 'Strategic IT advisory',
    description:
      'An independent architectural perspective on where to invest, where to simplify, and where not to build at all. Useful when important choices need to be made without turning the decision process into a performance of its own.',
    tags: ['Technology strategy', 'Modernisation', 'Cloud migration', 'AI adoption', 'Stakeholder alignment'],
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
    name: 'Independent software auditing',
    description:
      'Third-party review of software deliveries against agreed expectations. Relevant for quality, SDLC maturity, security, reliability, and regulatory concerns where an outside assessment should be concrete and useful rather than ceremonial.',
    tags: ['Third-party audit', 'SDLC review', 'Security assessment', 'Quality assurance', 'Regulatory compliance'],
  },
];
---

<Layout
  title="Services | COM<tech>"
  description="Software architecture, cloud and AI solutions, technical leadership, and independent software auditing services."
>

  <section class="section"><div class="container">
    <p class="section-label">Services</p>
    <h1 class="page-h1">Practical support for difficult technical work</h1>
    <p class="page-lead">
      The work typically sits somewhere between architecture, delivery, and technical leadership.
      Sometimes as a lead architect. Sometimes as an experienced outside perspective. Sometimes as
      hands-on support when the situation calls for it.
    </p>

    <div class="svc-grid">
      {services.map((s, i) => (
        <div class={`svc-card${i === 0 ? ' svc-featured' : ''}`}>
          <div class="svc-icon" set:html={s.icon} />
          <h3 class="svc-title">{s.name}</h3>
          <p class="svc-desc">{s.description}</p>
          <div class="svc-tags">
            {s.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div></section>

  <section class="section section-alt" style="padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container">
      <p class="section-label">Typical situations</p>
      <div class="card-grid">
        <div class="card">
          <h3>The system has become too hard to reason about</h3>
          <p>Responsibilities are blurred, integrations have grown fragile, and every change feels more expensive than it should.</p>
        </div>
        <div class="card">
          <h3>An important technical decision needs firmer footing</h3>
          <p>For example around modernisation, cloud direction, architecture boundaries, or whether a proposed path is actually worth the cost.</p>
        </div>
        <div class="card">
          <h3>The team needs senior technical direction</h3>
          <p>Not more noise, but clearer judgement, better structure, and help carrying the work through delivery in a sustainable way.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <p class="section-label">When to reach out</p>
      <h2>Not sure which kind of help fits yet?</h2>
      <p>That is fine. The useful first conversation is usually about the problem itself, what is at stake, and where clearer technical judgement would help most.</p>
      <a href="/contact/" class="btn btn-primary">Contact Anders</a>
    </div>
  </section>

</Layout>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .svc-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .svc-card:hover {
    box-shadow: var(--shadow);
    border-color: #d4d4d8;
  }
  .svc-featured {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #fafaff 0%, #f0f0ff 100%);
    border-color: rgba(83, 82, 204, 0.2);
  }
  .svc-featured .svc-title { font-size: 1.25rem; }
  .svc-icon {
    width: fit-content;
    padding: 0.5rem;
    background: var(--accent-dim);
    border-radius: 8px;
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .svc-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .svc-desc {
    font-size: 0.9375rem;
    color: var(--text-2);
    line-height: 1.7;
    flex: 1;
  }
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }
  @media (max-width: 680px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
