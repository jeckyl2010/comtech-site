---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import CtaStrip from '../components/CtaStrip.astro';
import about from '../data/about.json';

const { domains } = about;
const countWords = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const domainCount = countWords[domains.length] ?? String(domains.length);

const court = (await getCollection('awards')).find(a => a.data.featured)!.data;
const quote = async (id: string) => (await getEntry('testimonials', id))!.data;
const [isabela, arne, mads, janus] = await Promise.all(
  ['isabela-bolotti', 'arne-beck', 'mads-jaeger', 'janus-toth'].map(quote),
);
---

<Layout
  title="COM<tech> | Software Architecture & Technical Leadership"
  description="Senior software architect based in Copenhagen. Architecture, technical leadership, and pragmatic delivery for organisations where reliability, traceability, and long-term maintainability matter."
>

  <section class="hero dark-section">
    <div class="aurora" aria-hidden="true">
      <div class="aurora-blob aurora-blob-1"></div>
      <div class="aurora-blob aurora-blob-2"></div>
      <div class="aurora-blob aurora-blob-3"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <div class="hero-inner">

      <div>
        <h1>Software architecture built for the places where it has to work.</h1>
        <p class="hero-sub">
          COM&lt;tech&gt; is Anders Hybertz, a senior software architect and technical lead with
          three decades of experience across pharmaceutical manufacturing, finance, energy,
          telecom, and the public sector. Brought in when the architecture matters, the delivery
          has to work, and the solution should still make sense after the excitement has worn off.
        </p>
        <div class="hero-actions">
          <a href="/services/" class="btn btn-primary">See services</a>
          <a href="/contact/" class="btn btn-ghost-dark">Contact Anders</a>
        </div>
      </div>

      <div class="hero-proof">
        <ul class="hero-awards-stack">
          <li class="hero-award-row hero-award-row--featured">
            <span class="hero-award-label">
              Court-appointed independent software expert
              <span class="hero-award-issuer">{court.issuer}</span>
            </span>
            <span class="hero-award-year">{court.year}</span>
          </li>
          <li class="hero-award-row">
            <span class="hero-award-label">Best Individual Performance, 7N consultancy network</span>
            <span class="hero-award-year">2016 &amp; 2020</span>
          </li>
          <li class="hero-award-row">
            <span class="hero-award-label">PSQIT Innovation Prize, Novo Nordisk</span>
            <span class="hero-award-year">2020</span>
          </li>
        </ul>
        <figure class="hero-quote">
          <blockquote>&ldquo;{isabela.excerpt}&rdquo;</blockquote>
          <figcaption class="testimonial-author">
            <strong>{isabela.name}</strong><br />
            {isabela.title}
          </figcaption>
        </figure>
      </div>

    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Practical help where architecture and delivery meet</h2>
      <div class="bento-grid">

        <div class="bento-card bento-featured">
          <h3>Clear architecture for complex environments</h3>
          <p>
            Greenfield or legacy. Regulated environments or ordinary line-of-business systems.
            The goal is the same: sound decisions, clear boundaries, and a solution the team can
            work with over time.
          </p>
          <a href="/services/" class="bento-link">View all services &rarr;</a>
        </div>

        <div class="bento-card bento-domains">
          <p class="bento-stat">{domainCount} industries.<br />One senior point of contact.</p>
          <div class="bento-tag-cloud">
            {domains.map(d => <span class="tag">{d}</span>)}
          </div>
        </div>

        <div class="bento-card">
          <h3>Cloud and AI, used where it creates value</h3>
          <p>
            Azure-native platforms, event-driven systems, containerised workloads, and AI solutions
            that still have to meet operational, compliance, and delivery realities.
          </p>
        </div>

        <div class="bento-card">
          <h3>Teams should be stronger when the engagement ends</h3>
          <p>
            Architecture reviews, mentoring, technical direction, and hands-on support where needed.
            The aim is not dependency. It is a team that can carry the work forward with confidence.
          </p>
        </div>

        <figure class="bento-card bento-mini-quote">
          <blockquote class="bento-pull">&ldquo;{arne.excerpt}&rdquo;</blockquote>
          <figcaption class="testimonial-author"><strong>{arne.name}</strong>, {arne.title}</figcaption>
        </figure>

      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">From the people who worked alongside him</h2>
      <div class="quote-pair">
        {[mads, janus].map(t => (
          <figure class="blockquote-card">
            <blockquote>&ldquo;{t.excerpt}&rdquo;</blockquote>
            <figcaption class="testimonial-author"><strong>{t.name}</strong>, {t.title}</figcaption>
          </figure>
        ))}
      </div>
      <a href="/testimonials/" class="btn btn-ghost quote-pair-cta">Read all recommendations</a>
    </div>
  </section>

  <CtaStrip
    heading="Need an experienced architectural perspective?"
    body="Typically when a delivery has become harder to steer, a technical decision carries real consequences, or the team needs a calm senior perspective without turning the process into a performance."
  >
    <a href="/contact/" class="btn btn-primary">Get in touch</a>
  </CtaStrip>

</Layout>

<style>
  .quote-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .quote-pair-cta { margin-top: 2rem; }
  @media (max-width: 780px) {
    .quote-pair { grid-template-columns: 1fr; }
  }
</style>
